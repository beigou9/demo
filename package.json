{
  "name": "laozhou-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "shot": "node tools/shot.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "tsc --noEmit && node tools/pack.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
